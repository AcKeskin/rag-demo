{
  "name": "rag-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Ask questions about my CV and projects. RAG on Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "index": "node scripts/build-index.ts",
    "build": "npm run index && node scripts/build-web.ts",
