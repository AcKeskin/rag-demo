    "check": "npm run index && tsc --noEmit && vitest run",
    "dev": "npm run index && wrangler dev",
    "deploy": "npm run index && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
